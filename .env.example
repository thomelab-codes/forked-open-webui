# ============================================================================
# Open WebUI — Docker Compose Environment Variables
# ============================================================================
# Copy this file to .env and edit as needed:
#   cp .env.example .env
#
# Variables here are automatically picked up by docker-compose.yaml
# and its overlay files. Uncomment and change any value you need.
# ============================================================================

# ---------- Docker image tags ------------------------------------------------
# WEBUI_DOCKER_TAG=main
# OLLAMA_DOCKER_TAG=latest

# ---------- Ports ------------------------------------------------------------
# Host port for the Open WebUI frontend (docker-compose.yaml)
# OPEN_WEBUI_PORT=3000

# Host port for the Ollama API when using docker-compose.api.yaml
# OLLAMA_WEBAPI_PORT=11434

# ---------- Ollama -----------------------------------------------------------
# Ollama URL used by the backend (overridden to http://ollama:11434 in Compose)
OLLAMA_BASE_URL='http://localhost:11434'

# ---------- OpenAI-compatible API --------------------------------------------
OPENAI_API_BASE_URL=''
OPENAI_API_KEY=''

# ---------- Image generation -------------------------------------------------
# AUTOMATIC1111_BASE_URL="http://localhost:7860"

# ---------- Security ---------------------------------------------------------
# Secret key for session/JWT signing. Leave empty to auto-generate on first run.
# WEBUI_SECRET_KEY=''

# ---------- GPU support (docker-compose.gpu.yaml) ----------------------------
# OLLAMA_GPU_DRIVER=nvidia
# OLLAMA_GPU_COUNT=1

# ---------- AMD GPU support (docker-compose.amdgpu.yaml) ---------------------
# HSA_OVERRIDE_GFX_VERSION=11.0.0

# ---------- Ollama data bind-mount (docker-compose.data.yaml) ----------------
# OLLAMA_DATA_DIR=./ollama-data

# ---------- CORS / proxy -----------------------------------------------------
CORS_ALLOW_ORIGIN='*'
FORWARDED_ALLOW_IPS='*'

# ---------- Telemetry opt-out ------------------------------------------------
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false